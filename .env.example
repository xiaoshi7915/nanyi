# 数据库配置
DB_HOST=your_db_host
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# 阿里云OSS配置（如使用OSS存储）
OSS_ACCESS_KEY_ID=your_real_access_key_id
OSS_ACCESS_KEY_SECRET=your_real_access_key_secret
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=your_bucket_name

# 火山引擎方舟（Try-On / Seedream）配置
ARK_API_KEY=your_ark_api_key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 默认：doubao-seedream-4-5-251128；如需切换模型，请修改此项为对应的 Ark model 名称
ARK_MODEL_NAME=doubao-seedream-4-5-251128

# 图生图固定 prompt（用于 AI 试穿图生图的整段中文提示词；留空则使用后端模板拼接）
TRY_ON_FIXED_PROMPT=

# 生成水印开关（对齐 Ark 示例：可开可关；留空默认不加水印）
TRY_ON_WATERMARK=false

# 应用配置
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your_secret_key

# 管理后台 API 令牌（/api/admin/*，请求头 X-Admin-Token 或 Authorization: Bearer）
ADMIN_API_TOKEN=your_admin_api_token

# 用户 JWT（可选单独配置；不设置则复用 SECRET_KEY）
JWT_SECRET_KEY=
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=30

# 微信网页授权（公众号 / 开放平台移动应用等，需在微信侧配置授权回调域名）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 须与微信后台「授权回调页」一致，默认 BACKEND_URL + /api/auth/wechat/callback
WECHAT_OAUTH_REDIRECT_URI=

# 登录用户试衣月度配额上限（与限流逻辑配合）
TRY_ON_USER_MONTHLY_QUOTA=30

# 服务端口
BACKEND_PORT=5432
FRONTEND_PORT=8500

# 域名配置
DOMAIN=your_domain
BACKEND_URL=http://your_domain:5432
FRONTEND_URL=http://your_domain:8500

# CORS配置
CORS_ORIGINS=http://your_domain:8500,http://localhost:8500

# Redis配置（用于缓存）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=