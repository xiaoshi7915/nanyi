/**
 * 图标系统
 * 采用 SVG 内联遮罩（-webkit-mask）实现：零图片资源、任意着色、矢量清晰。
 * 用法：<view class="icon icon--home icon-c-primary" />
 * 注：mask 仅取形状透明度，SVG 内 fill 统一为 black，颜色由 background-color 决定。
 * 兼容性：data URI 未做百分号编码，WebView 内核可正常解析；若个别机型不显示，
 *        可把对应 mask-image 换成 base64 形式（data:image/svg+xml;base64,...）。
 */

.icon {
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  background-color: currentColor;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
  flex-shrink: 0;
}

/* ---------- 颜色 ---------- */
.icon-c-ink { background-color: #2A2521; }
.icon-c-ink2 { background-color: #6B6257; }
.icon-c-ink3 { background-color: #9A9184; }
.icon-c-primary { background-color: #9C2824; }
.icon-c-gold { background-color: #A98B4E; }
.icon-c-green { background-color: #244048; }
.icon-c-light { background-color: #FCF8F0; }
.icon-c-white { background-color: #FFFDF7; }

