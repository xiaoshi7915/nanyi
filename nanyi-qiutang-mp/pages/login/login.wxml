<view class="page">
  <view class="nav" style="padding-top:{{statusBarHeight}}px">
    <view class="nav__bar" style="height:{{navBarHeight}}px">
      <view class="nav__back" bindtap="onBack">
        <view class="nav__back-icon icon icon--arrow-left icon-c-ink" />
      </view>
    </view>
  </view>

  <view class="body">
    <view class="brand">
      <view class="brand__logo">棠</view>
      <text class="brand__name">{{brand.name}}</text>
      <text class="brand__en">{{brand.enName}} · {{brand.slogan}}</text>
    </view>

    <text class="title">{{title}}</text>
    <text class="tip" wx:if="{{tip}}">{{tip}}</text>

    <view class="form">
      <!-- 登录：手机号或邮箱 -->
      <view class="field" wx:if="{{mode === 'login'}}">
        <text class="field__label">手机号 / 邮箱</text>
        <input
          class="field__input"
          type="text"
          value="{{account}}"
          placeholder="请输入手机号或邮箱"
          placeholder-class="field__ph"
          data-field="account"
          bindinput="onInput"
        />
      </view>

      <!-- 注册：手机号 -->
      <view class="field" wx:if="{{mode === 'register'}}">
        <text class="field__label">手机号</text>
        <input
          class="field__input"
          type="number"
          maxlength="11"
          value="{{phone}}"
          placeholder="请输入 11 位手机号"
          placeholder-class="field__ph"
          data-field="phone"
          bindinput="onInput"
        />
      </view>

      <!-- 找回密码：邮箱（后端仅支持 email） -->
      <view class="field" wx:if="{{mode === 'forgot'}}">
        <text class="field__label">注册邮箱</text>
        <input
          class="field__input"
          type="text"
          value="{{email}}"
          placeholder="请输入注册时使用的邮箱"
          placeholder-class="field__ph"
          data-field="email"
          bindinput="onInput"
        />
      </view>

      <view class="field" wx:if="{{mode !== 'forgot'}}">
        <text class="field__label">密码</text>
        <input
          class="field__input"
          password
          value="{{password}}"
          placeholder="请输入密码（至少 6 位）"
          placeholder-class="field__ph"
          data-field="password"
          bindinput="onInput"
        />
      </view>

      <view class="field" wx:if="{{mode === 'register'}}">
        <text class="field__label">确认密码</text>
        <input
          class="field__input"
          password
          value="{{confirm}}"
          placeholder="请再次输入密码"
          placeholder-class="field__ph"
          data-field="confirm"
          bindinput="onInput"
        />
      </view>

      <view class="field" wx:if="{{mode === 'register'}}">
        <text class="field__label">昵称（选填）</text>
        <input
          class="field__input"
          value="{{nickname}}"
          placeholder="用于展示的称呼"
          placeholder-class="field__ph"
          data-field="nickname"
          bindinput="onInput"
        />
      </view>
    </view>

    <text class="error" wx:if="{{error}}">{{error}}</text>

    <view class="submit {{submitting ? 'submit--busy' : ''}}" bindtap="onSubmit">{{submitText}}</view>

    <view class="links">
      <text class="link" wx:if="{{mode !== 'login'}}" data-mode="login" bindtap="onModeTap">已有账号 · 登录</text>
      <text class="link" wx:if="{{mode === 'login'}}" data-mode="register" bindtap="onModeTap">注册新账号</text>
      <text class="link" wx:if="{{mode === 'login'}}" data-mode="forgot" bindtap="onModeTap">忘记密码</text>
      <text class="link" wx:if="{{mode === 'forgot'}}" data-mode="login" bindtap="onModeTap">返回登录</text>
    </view>
  </view>

  <view class="footer">
    <text>{{brand.copyright}}</text>
  </view>
</view>
