@import "../../styles/icons.wxss";

/* ---------------- 顶部品牌栏 ---------------- */
.header {
  background: #F4F0E4;
}

.header__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 92rpx;
  padding: 0 30rpx;
}

.header__brand {
  display: flex;
  align-items: center;
  min-width: 0;
}

.header__logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 10rpx;
  background: #9C2824;
  color: #FCF8F0;
  font-size: 34rpx;
  font-family: "Songti SC", "STSong", serif;
  line-height: 1;
}

.header__names {
  margin-left: 18rpx;
  min-width: 0;
}

.header__cn {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #191512;
  letter-spacing: 3rpx;
  line-height: 1.25;
}

.header__en {
  display: block;
  margin-top: 2rpx;
  font-size: 19rpx;
  color: #A98B4E;
  letter-spacing: 2rpx;
}

.header__actions {
  display: flex;
  align-items: center;
}

.header__action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-left: 16rpx;
  border-radius: 50%;
  border: 1rpx solid #E0D8C6;
  background: rgba(252, 248, 240, 0.7);
}

.header__action-icon {
  width: 38rpx;
  height: 38rpx;
}

/* ---------------- Banner ---------------- */
.banner {
  position: relative;
  margin-top: 6rpx;
  padding: 40rpx 36rpx 36rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #2A4A53 0%, #244048 45%, #1B3138 100%);
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(27, 49, 56, 0.18);
}

.banner__watermark {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 104rpx;
  line-height: 0.98;
  font-family: "Songti SC", "STSong", serif;
  color: rgba(252, 248, 240, 0.07);
  letter-spacing: 4rpx;
  writing-mode: vertical-rl;
  text-orientation: upright;
}

.banner__deco {
  position: absolute;
  right: -70rpx;
  bottom: -90rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 40rpx;
  background: rgba(252, 248, 240, 0.045);
  transform: rotate(45deg);
}

.banner__copy {
  position: relative;
  z-index: 1;
}

.banner__eyebrow {
  display: block;
  font-size: 22rpx;
  color: #C9AE74;
  letter-spacing: 2rpx;
}

.banner__title {
  display: block;
  margin-top: 14rpx;
  font-size: 52rpx;
  font-weight: 600;
  color: #FBF6EA;
  letter-spacing: 3rpx;
  line-height: 1.3;
}

.banner__sub {
  display: block;
  margin-top: 12rpx;
  font-size: 23rpx;
  color: rgba(251, 246, 234, 0.72);
  letter-spacing: 1rpx;
}

.banner__cta {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
}

.banner__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 62rpx;
  padding: 0 34rpx;
  border-radius: 31rpx;
  font-size: 25rpx;
  letter-spacing: 2rpx;
}

.banner__btn--solid {
  background: #9C2824;
  color: #FDF6EC;
}

.banner__btn--outline {
  margin-left: 20rpx;
  border: 1rpx solid rgba(201, 174, 116, 0.75);
  color: #E4D3AC;
}

.banner__btn:active {
  opacity: 0.85;
}

/* ---------------- 搜索 ---------------- */
.search {
  display: flex;
  align-items: center;
  height: 88rpx;
  margin-top: 26rpx;
  padding: 0 10rpx 0 28rpx;
  border-radius: 44rpx;
  background: #FFFDF7;
  box-shadow: 0 2rpx 12rpx rgba(120, 100, 70, 0.05);
}

.search__icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 14rpx;
}

.search__input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  font-size: 26rpx;
  color: #2A2521;
}

.search__ph {
  color: #B4AA9A;
  letter-spacing: 1rpx;
}

.search__clear {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
}

.search__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  padding: 0 30rpx;
  border-radius: 34rpx;
  font-size: 27rpx;
  font-weight: 500;
  color: #9C2824;
  letter-spacing: 2rpx;
}

.search__btn:active {
  background: rgba(156, 40, 36, 0.06);
}

/* ---------------- 年份 ---------------- */
.years {
  display: flex;
  width: 100%;
  margin-top: 28rpx;
  white-space: nowrap;
}

.years .chip {
  flex-shrink: 0;
}

/* ---------------- 网格 ---------------- */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 6rpx;
}

.grid__item {
  width: 48.6%;
  margin-bottom: 22rpx;
}

/* 骨架 */
.ph-card {
  padding-bottom: 20rpx;
  border-radius: 16rpx;
  background: #FCF8F0;
  overflow: hidden;
}

.ph-card__cover {
  width: 100%;
  padding-bottom: 106%;
  border-radius: 0;
}

.ph-card__line {
  height: 24rpx;
  margin: 18rpx 20rpx 0;
  border-radius: 8rpx;
}

/* ---------------- 查看全部 ---------------- */
.view-all {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  margin-top: 18rpx;
  border-radius: 50rpx;
  background: #FFFDF7;
  font-size: 28rpx;
  color: #2A2521;
  letter-spacing: 2rpx;
  box-shadow: 0 2rpx 12rpx rgba(120, 100, 70, 0.05);
}

.view-all:active {
  opacity: 0.85;
}

.view-all__arrow {
  width: 26rpx;
  height: 26rpx;
  margin-left: 12rpx;
  background-color: #6B6257;
}

/* 底部留白（tabBar 高度 + 安全区） */
.page-body {
  padding-bottom: 8rpx;
}

.footer {
  padding: 44rpx 0 200rpx;
}
