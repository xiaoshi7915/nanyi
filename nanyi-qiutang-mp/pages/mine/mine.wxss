@import "../../styles/icons.wxss";

.page {
  min-height: 100vh;
  background: #F4F0E4;
}

/* ---------------- 标题 ---------------- */
.header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-bottom: 34rpx;
}

.header__title {
  font-size: 40rpx;
  font-weight: 600;
  color: #191512;
  letter-spacing: 4rpx;
}

.body {
  padding: 0 30rpx;
}

/* ---------------- 登录卡片 ---------------- */
.login-card {
  display: flex;
  align-items: center;
  padding: 34rpx 30rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #2A4A53 0%, #244048 55%, #1B3138 100%);
  box-shadow: 0 8rpx 22rpx rgba(27, 49, 56, 0.18);
}

.login-card:active {
  opacity: 0.94;
}

.login-card__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #E8DFC8;
  flex-shrink: 0;
}

.login-card__avatar-icon {
  width: 54rpx;
  height: 54rpx;
  background-color: #4A443A;
}

.login-card__text {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.login-card__title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #FBF6EA;
  letter-spacing: 2rpx;
}

.login-card__desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(251, 246, 234, 0.68);
}

.login-card__wechat {
  width: 52rpx;
  height: 52rpx;
  background-color: #7ECB8F;
  flex-shrink: 0;
}

.login-card__more {
  width: 26rpx;
  height: 26rpx;
  background-color: rgba(251, 246, 234, 0.7);
  flex-shrink: 0;
}

/* ---------------- 我的试穿 / 最近浏览 ---------------- */
.duo {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
}

.duo__card {
  width: 48.6%;
  padding: 24rpx 22rpx 22rpx;
  border-radius: 20rpx;
  background: #FFFDF7;
  box-shadow: 0 2rpx 12rpx rgba(120, 100, 70, 0.05);
}

.duo__card:active {
  opacity: 0.92;
}

.duo__head {
  display: flex;
  align-items: center;
}

.duo__icon {
  width: 34rpx;
  height: 34rpx;
  margin-right: 12rpx;
  background-color: #9C2824;
}

.duo__icon--gold {
  background-color: #A98B4E;
}

.duo__title {
  font-size: 27rpx;
  font-weight: 500;
  color: #191512;
  letter-spacing: 1rpx;
}

.duo__thumbs {
  display: flex;
  margin-top: 18rpx;
}

.duo__thumb {
  width: 50%;
  height: 130rpx;
  border-radius: 10rpx;
  background: #F1EDE2;
  overflow: hidden;
}

.duo__thumb:first-child {
  margin-right: 12rpx;
}

.duo__thumb--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #DCD3BF;
  background: #FAF7EF;
}

.duo__empty-icon {
  width: 40rpx;
  height: 40rpx;
  background-color: #D3C9B4;
}

/* ---------------- 列表 ---------------- */
.list {
  border-radius: 20rpx;
  background: #FFFDF7;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(120, 100, 70, 0.05);
}

.row {
  position: relative;
  display: flex;
  align-items: center;
  height: 104rpx;
  padding: 0 26rpx;
}

.row::after {
  content: "";
  position: absolute;
  left: 26rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: #EEE8DA;
}

.row:last-child::after {
  display: none;
}

.row--hover {
  background: #FAF6EC;
}

.row__icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 20rpx;
  background-color: #A98B4E;
  flex-shrink: 0;
}

.row__label {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #2A2521;
  letter-spacing: 1rpx;
}

.row__value {
  font-size: 25rpx;
  color: #6B6257;
  margin-right: 16rpx;
}

.row__copy {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #A98B4E;
  border: 1rpx solid #E2D6B6;
}

.row__arrow {
  width: 24rpx;
  height: 24rpx;
  background-color: #C6BCA6;
  flex-shrink: 0;
}

/* 页脚 */
.footer {
  padding: 40rpx 0 0;
  text-align: center;
}

.footer__line {
  display: block;
  font-size: 22rpx;
  color: #B4AA9A;
  letter-spacing: 1rpx;
  line-height: 1.9;
}


/* 手机号登录备用入口 */
.alt-login {
  margin-top: 20rpx;
  padding: 8rpx 8rpx 4rpx;
  text-align: center;
}

.alt-login__text {
  font-size: 24rpx;
  color: #A98B4E;
  letter-spacing: 1rpx;
  text-decoration: underline;
}
